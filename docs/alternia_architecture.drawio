        </mxCell>
        <mxCell id="rag_store" value="&lt;b&gt;Vector Store (Hybride)&lt;/b&gt;&lt;br&gt;• LocalVectorStore (Index Pickle/Numpy)&lt;br&gt;• QdrantVectorStore (Collections SQLite)&lt;br&gt;&lt;i&gt;Filtrage strict sur classe + matière + score&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=11;" vertex="1" parent="group_rag">
          <mxGeometry x="20" y="290" width="260" height="75" as="geometry" />
        </mxCell>
        <mxCell id="rag_service" value="&lt;b&gt;SemanticRetriever &amp; RAGService&lt;/b&gt;&lt;br&gt;Recherche cosinus top-k (k=4) + seuil min&lt;br&gt;&lt;i&gt;Génération de RAGContext structuré&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=11;" vertex="1" parent="group_rag">
          <mxGeometry x="20" y="385" width="260" height="65" as="geometry" />
        </mxCell>

        <!-- CONTAINER INFERENCE LOCALE & AUDIO -->
