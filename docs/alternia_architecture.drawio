<mxfile host="app.diagrams.net" modified="2026-08-15T18:00:00.000Z" agent="AlternIA" version="21.0.0" type="device">
  <diagram id="vulgarise" name="1. Fonctionnement Grand Public">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Titre -->
        <mxCell id="title" value="AlternIA : Comment fonctionne le tuteur intelligent ? (Vue Simplifiée)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Un professeur particulier vocal, adapté au programme scolaire du Mali, fonctionnant même sans connexion internet" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="180" y="65" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- 1. ELEVE -->
        <mxCell id="box_eleve" value="&lt;b&gt;1. L'Élève Malien&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Choisit sa classe (10ème, 11ème, Terminale)&lt;br&gt;• Choisit sa matière (Maths, Physique, etc.)&lt;br&gt;• Pose sa question à l'écrit ou à l'oral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=13;fontColor=#1E3A8A;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="220" height="130" as="geometry" />
        </mxCell>

        <!-- 2. DISPOSITIF -->
        <mxCell id="box_device" value="&lt;b&gt;2. Le Dispositif AlternIA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Boîtier physique ou App Mobile&lt;br&gt;reçoit la question et active&lt;br&gt;l'intelligence pédagogique locale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=13;fontColor=#0F172A;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="210" height="130" as="geometry" />
        </mxCell>

        <!-- FLECHE 1 -> 2 -->
        <mxCell id="edge1" value="Question élève" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=2;fontSize=11;fontColor=#1E3A8A;" edge="1" parent="1" source="box_eleve" target="box_device">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 3. CERVEAU PEDAGOGIQUE -->
        <mxCell id="box_pedago" value="&lt;b&gt;3. Le Cerveau Pédagogique&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Analyse le niveau de l'élève&lt;br&gt;• Identifie s'il s'agit d'un cours ou d'un exercice&lt;br&gt;• Prépare une explication progressive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#78350F;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="580" y="140" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- FLECHE 2 -> 3 -->
        <mxCell id="edge2" value="Analyse du besoin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2;fontSize=11;fontColor=#78350F;" edge="1" parent="1" source="box_device" target="box_pedago">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4. BIBLIOTHEQUE NATIONALE -->
        <mxCell id="box_biblio" value="&lt;b&gt;4. La Bibliothèque Officielle&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tous les manuels et cours du Mali&lt;br&gt;sont enregistrés dans le boîtier.&lt;br&gt;&lt;i&gt;AlternIA retrouve en 0.1s les pages exactes du programme.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#10B981;strokeWidth=2;fontSize=13;fontColor=#064E3B;align=center;" vertex="1" parent="1">
          <mxGeometry x="870" y="140" width="240" height="130" as="geometry" />
        </mxCell>

        <!-- FLECHE 3 -> 4 -->
        <mxCell id="edge3" value="Recherche dans le manuel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;fontSize=11;fontColor=#064E3B;" edge="1" parent="1" source="box_pedago" target="box_biblio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 5. PROFESSEUR IA -->
        <mxCell id="box_ia" value="&lt;b&gt;5. L'Intelligence Artificielle Locale&lt;/b&gt;&lt;br&gt;&lt;br&gt;Formule une explication simple, étape par étape,&lt;br&gt;en se basant &lt;b&gt;uniquement&lt;/b&gt; sur le programme officiel du Mali.&lt;br&gt;&lt;i&gt;(Aucune hallucination, 100% conforme au programme)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=2;fontSize=13;fontColor=#581C87;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="530" height="110" as="geometry" />
        </mxCell>

        <!-- FLECHE 4 -> 5 -->
        <mxCell id="edge4" value="Extraits officiels trouvés" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A855F7;strokeWidth=2;fontSize=11;fontColor=#581C87;" edge="1" parent="1" source="box_biblio" target="box_ia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 6. REPONSE TEXTE -->
        <mxCell id="box_text" value="&lt;b&gt;6. Affichage Instantané&lt;/b&gt;&lt;br&gt;&lt;br&gt;Le texte s'affiche immédiatement mot à mot à l'écran." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontSize=12;fontColor=#334155;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="340" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- 7. VOIX HUMAINE -->
        <mxCell id="box_voice" value="&lt;b&gt;7. Voix Humaine HD&lt;/b&gt;&lt;br&gt;&lt;br&gt;Une voix claire et chaleureuse (style ChatGPT) lit l'explication et prononce les formules mathématiques en français naturel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#F43F5E;strokeWidth=2;fontSize=12;fontColor=#881337;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- FLECHES 5 -> 6 et 5 -> 7 -->
        <mxCell id="edge5" value="Texte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" parent="1" source="box_ia" target="box_text">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" value="Audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F43F5E;strokeWidth=2;" edge="1" parent="1" source="box_ia" target="box_voice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- RETOUR A L'ELEVE -->
        <mxCell id="edge7" value="L'élève écoute et lit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;dashed=1;" edge="1" parent="1" source="box_voice" target="box_eleve">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="475" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 8. CARNET DE REUSSITE -->
        <mxCell id="box_carnet" value="&lt;b&gt;8. Le Carnet de Réussite de l'Élève&lt;/b&gt;&lt;br&gt;&lt;br&gt;AlternIA retient ce que l'élève a compris et les notions qu'il doit réviser pour ses examens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFEFF;strokeColor=#06B6D4;strokeWidth=2;fontSize=13;fontColor=#164E63;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="edge8" value="Mémorisation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#06B6D4;strokeWidth=1.5;" edge="1" parent="1" source="box_ia" target="box_carnet">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="390" />
              <mxPoint x="550" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="technique" name="2. Architecture Technique (Data Science & Devs)">
