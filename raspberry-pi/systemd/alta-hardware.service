[Unit]
Description=Alta-Box 4-Buttons (Niveaux 1-2-3, Micro Toggle) & Tricolor RGB LED Controller
After=sound.target multi-user.target
Wants=sound.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/AlternIA/raspberry-pi
ExecStart=/usr/bin/python3 /home/ubuntu/AlternIA/raspberry-pi/hardware/buttons_audio_controller.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alta-hardware

[Install]
WantedBy=multi-user.target
