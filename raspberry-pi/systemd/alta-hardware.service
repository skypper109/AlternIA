[Unit]
Description=Alta-Box 4-Buttons (Niveaux 1-2-3, Micro Toggle) & Tricolor RGB LED Controller
After=sound.target multi-user.target
Wants=sound.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -c "for d in /home/ubuntu/Alternia/raspberry-pi /home/ubuntu/AlternIA/raspberry-pi; do if [ -d \"$d\" ]; then cd \"$d\" && exec /usr/bin/python3 hardware/buttons_audio_controller.py; fi; done"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alta-hardware

[Install]
WantedBy=multi-user.target
