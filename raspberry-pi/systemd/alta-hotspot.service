[Unit]
Description=Alta-Box Wi-Fi Hotspot Daemon (NetworkManager Alta-box1)
After=NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "nmcli connection up Alta-Hotspot || nmcli device wifi hotspot ifname uap0 ssid Alta_box1 password Alta_box2026 2>/dev/null || nmcli device wifi hotspot ifname wlan0 ssid Alta_box1 password Alta_box2026"

[Install]
WantedBy=multi-user.target
